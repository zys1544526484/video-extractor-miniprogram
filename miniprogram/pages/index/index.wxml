<view class="page-shell home-page">
  <view class="ad-region" wx:if="{{showBannerAd}}">
    <ad
      wx:if="{{bannerAdUnitId}}"
      unit-id="{{bannerAdUnitId}}"
      ad-type="banner"
      ad-intervals="30"
      binderror="onBannerAdError"
    />
    <view class="dev-ad" wx:else>
      <text class="dev-ad-label">广告位</text>
      <text>配置真实 Banner adUnitId 后展示</text>
    </view>
  </view>

  <view class="notice-line">
    <text class="notice-icon">i</text>
    <text>{{accessMode === 'free' ? '解析、预览和保存当前均免费' : '解析和预览免费，保存时解锁下载权益'}}</text>
  </view>

  <view class="entitlement-strip" wx:if="{{accessMode === 'rewarded_ad'}}">
    <text class="info-icon">i</text>
    <text>{{entitlementLabel}}</text>
  </view>

  <view class="input-panel">
    <textarea
      class="share-input"
      value="{{inputText}}"
      maxlength="5000"
      placeholder="粘贴视频分享文案或链接"
      placeholder-class="input-placeholder"
      bindinput="onInput"
      bindblur="onBlur"
      auto-height="false"
      show-confirm-bar="false"
      aria-label="视频分享文案或链接"
    />
    <text class="char-count">{{charCount}}/5000</text>
  </view>

  <view class="quality-panel">
    <view class="quality-heading">
      <text class="quality-title">提取画质</text>
      <text class="quality-hint">对应档位不可用时会返回最接近的较低公开画质</text>
    </view>
    <view class="quality-options">
      <view
        wx:for="{{qualityOptions}}"
        wx:key="value"
        class="quality-option {{selectedQuality === item.value ? 'quality-option-active' : ''}} {{busy ? 'quality-option-disabled' : ''}}"
        data-value="{{item.value}}"
        bindtap="selectQuality"
        role="button"
        aria-label="选择{{item.label}}画质"
      >
        <text class="quality-option-label">{{item.label}}</text>
        <text class="quality-option-note">{{item.note}}</text>
      </view>
    </view>
  </view>

  <view class="action-row">
    <button class="primary-button parse-button" disabled="{{busy || atJobLimit}}" bindtap="startParse">{{atJobLimit ? '已有 2 个任务' : buttonText}}</button>
    <button class="secondary-button paste-button" disabled="{{busy}}" bindtap="pasteClipboard">粘贴</button>
  </view>

  <view class="active-tasks" wx:if="{{activeJobCount}}">
    <view class="active-tasks-heading">
      <view><text class="active-tasks-title">正在提取 {{activeJobCount}} 个视频</text><text class="active-tasks-hint">最多同时提交 2 个</text></view>
      <text class="history-link" bindtap="openHistory">查看记录</text>
    </view>
    <view class="active-task" wx:for="{{activeJobs}}" wx:key="job_id" bindtap="openHistory">
      <view class="active-task-copy">
        <text class="active-task-platform">{{item.platform_label}}</text>
        <text class="active-task-stage">{{item.stage}}</text>
        <text class="active-task-progress">{{item.progress}}%</text>
      </view>
      <view class="parse-progress-track"><view class="parse-progress-value" style="width: {{item.progress}}%;"></view></view>
    </view>
    <text class="parse-progress-hint">任务会在后台继续，可离开页面后从提取记录打开结果</text>
  </view>

  <view class="legal-copy">
    <text>仅处理公开可访问且你有权保存的内容</text>
    <text>部分内容可能短时缓存，并在任务结束或过期后自动清理</text>
  </view>

  <view class="utility-list">
    <view class="utility-row" bindtap="openTutorial" role="button" aria-label="使用教程">
      <image class="utility-icon" src="/assets/icons/book.svg" />
      <text class="utility-title">使用教程</text>
      <image class="chevron" src="/assets/icons/chevron.svg" />
    </view>
    <view class="utility-row" bindtap="openFaq" role="button" aria-label="常见问题">
      <image class="utility-icon" src="/assets/icons/help.svg" />
      <text class="utility-title">常见问题</text>
      <image class="chevron" src="/assets/icons/chevron.svg" />
    </view>
    <view class="utility-row utility-row-last" bindtap="openMine" role="button" aria-label="我的页面">
      <image class="utility-icon" src="/assets/icons/shield.svg" />
      <text class="utility-title">我的</text>
      <image class="chevron" src="/assets/icons/chevron.svg" />
    </view>
  </view>
</view>
