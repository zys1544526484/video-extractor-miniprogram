.home-page {
  padding-top: 10px;
}

.ad-region {
  margin-bottom: 12px;
  overflow: hidden;
  border-radius: 10px;
}

.dev-ad {
  display: flex;
  align-items: center;
  min-height: 52px;
  padding: 0 14px;
  color: #8a8a8a;
  font-size: 13px;
  background: #fff;
  border: 1px dashed #d6d7da;
  box-sizing: border-box;
}

.dev-ad-label {
  margin-right: 10px;
  padding: 2px 6px;
  color: #07c160;
  border: 1px solid #07c160;
  border-radius: 4px;
}

.notice-line {
  display: flex;
  align-items: center;
  margin: 0 2px 12px;
  color: #73757a;
  font-size: 14px;
  line-height: 22px;
}

.notice-icon,
.info-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  margin-right: 9px;
  color: #07c160;
  font-size: 13px;
  font-weight: 600;
  border: 1.5px solid #07c160;
  border-radius: 50%;
  box-sizing: border-box;
}

.notice-icon {
  color: #73757a;
  border-color: #73757a;
}

.entitlement-strip {
  display: flex;
  align-items: center;
  min-height: 48px;
  margin-bottom: 16px;
  padding: 0 14px;
  color: #3a3b3f;
  font-size: 15px;
  background: #f0faf4;
  border-radius: 10px;
  box-sizing: border-box;
}

.input-panel {
  position: relative;
  height: 220px;
  background: #fff;
  border: 1px solid #cfd1d4;
  border-radius: 12px;
  box-sizing: border-box;
}

.share-input {
  width: 100%;
  height: 100%;
  padding: 18px 16px 36px;
  color: #1f1f1f;
  font-size: 17px;
  line-height: 1.6;
  box-sizing: border-box;
}

.input-placeholder {
  color: #a4a6aa;
}

.char-count {
  position: absolute;
  right: 14px;
  bottom: 10px;
  color: #a4a6aa;
  font-size: 13px;
}

.quality-panel {
  margin-top: 14px;
  padding: 14px;
  background: #fff;
  border-radius: 12px;
}

.quality-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12px;
}

.quality-title {
  flex: 0 0 auto;
  color: #1f1f1f;
  font-size: 15px;
  font-weight: 600;
}

.quality-hint {
  margin-left: 12px;
  color: #8a8a8a;
  font-size: 11px;
  line-height: 16px;
  text-align: right;
}

.quality-options {
  display: flex;
}

.quality-option {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 0;
  height: 58px;
  margin-right: 9px;
  color: #5f6166;
  background: #f7f8fa;
  border: 1px solid #e2e3e5;
  border-radius: 9px;
  box-sizing: border-box;
}

.quality-option:last-child {
  margin-right: 0;
}

.quality-option-active {
  color: #07a950;
  background: #eefaf3;
  border-color: #07c160;
  box-shadow: 0 0 0 1px rgba(7, 193, 96, 0.08);
}

.quality-option-disabled {
  opacity: 0.55;
}

.quality-option-label {
  font-size: 15px;
  font-weight: 600;
  line-height: 21px;
}

.quality-option-note {
  margin-top: 1px;
  font-size: 11px;
  line-height: 16px;
}

.action-row {
  display: flex;
  margin-top: 14px;
}

.active-tasks {
  margin-top: 14px;
  padding: 14px;
  background: #fff;
  border: 1px solid #e7e8eb;
  border-radius: 12px;
}

.active-tasks-heading,
.active-task-copy {
  display: flex;
  align-items: center;
}

.active-tasks-heading {
  justify-content: space-between;
  margin-bottom: 12px;
}

.active-tasks-heading > view {
  display: flex;
  flex-direction: column;
}

.active-tasks-title {
  color: #1f1f1f;
  font-size: 15px;
  font-weight: 600;
}

.active-tasks-hint {
  color: #8a8a8a;
  font-size: 12px;
}

.history-link {
  color: #07a950;
  font-size: 14px;
}

.active-task {
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #f0f0f1;
}

.active-task-copy {
  margin-bottom: 7px;
  color: #73757a;
  font-size: 13px;
}

.active-task-platform {
  flex: 0 0 auto;
  margin-right: 8px;
  color: #07a950;
}

.active-task-stage {
  min-width: 0;
  flex: 1;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.active-task-progress {
  margin-left: 8px;
}

.parse-progress-track {
  height: 7px;
  overflow: hidden;
  background: #e8eaec;
  border-radius: 4px;
}

.parse-progress-value {
  height: 100%;
  background: #07c160;
  border-radius: 4px;
  transition: width 0.2s ease;
}

.parse-progress-hint {
  display: block;
  margin-top: 9px;
  color: #8a8a8a;
  font-size: 12px;
  line-height: 18px;
}

.parse-button {
  flex: 1;
  margin-right: 10px;
}

.paste-button {
  width: 120px;
  flex: 0 0 120px;
}

.legal-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 18px 6px;
  color: #8a8a8a;
  font-size: 13px;
  line-height: 22px;
  text-align: center;
}

.utility-list {
  padding: 0 16px;
  background: #fff;
  border-radius: 12px;
}

.utility-row {
  display: flex;
  align-items: center;
  height: 66px;
  border-bottom: 1px solid #ededee;
}

.utility-row-last {
  border-bottom: 0;
}

.utility-icon {
  width: 27px;
  height: 27px;
  margin-right: 17px;
}

.utility-title {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}

.chevron {
  width: 20px;
  height: 20px;
}

@media (max-width: 360px) {
  .input-panel {
    height: 190px;
  }

  .paste-button {
    width: 96px;
    flex-basis: 96px;
  }

  .legal-copy {
    font-size: 12px;
  }

  .quality-panel {
    padding: 12px;
  }

  .quality-hint {
    max-width: 190px;
  }

  .quality-option {
    margin-right: 6px;
  }
}
