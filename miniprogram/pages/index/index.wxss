.home-page {
  padding-top: 10px;
}

.ad-region {
  margin-bottom: 12px;
  overflow: hidden;
  border-radius: 10px;
}

.dev-ad {
  display: flex;
  align-items: center;
  min-height: 52px;
  padding: 0 14px;
  color: #8a8a8a;
  font-size: 13px;
  background: #fff;
  border: 1px dashed #d6d7da;
  box-sizing: border-box;
}

.dev-ad-label {
  margin-right: 10px;
  padding: 2px 6px;
  color: #07c160;
  border: 1px solid #07c160;
  border-radius: 4px;
}

.notice-line {
  display: flex;
  align-items: center;
  margin: 0 2px 12px;
  color: #73757a;
  font-size: 14px;
  line-height: 22px;
}

.notice-icon,
.info-icon {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 20px;
  height: 20px;
  margin-right: 9px;
  color: #07c160;
  font-size: 13px;
  font-weight: 600;
  border: 1.5px solid #07c160;
  border-radius: 50%;
  box-sizing: border-box;
}

.notice-icon {
  color: #73757a;
  border-color: #73757a;
}

.entitlement-strip {
  display: flex;
  align-items: center;
  min-height: 48px;
  margin-bottom: 16px;
  padding: 0 14px;
  color: #3a3b3f;
  font-size: 15px;
  background: #f0faf4;
  border-radius: 10px;
  box-sizing: border-box;
}

.input-panel {
  position: relative;
  height: 220px;
  background: #fff;
  border: 1px solid #cfd1d4;
  border-radius: 12px;
  box-sizing: border-box;
}

.share-input {
  width: 100%;
  height: 100%;
  padding: 18px 16px 36px;
  color: #1f1f1f;
  font-size: 17px;
  line-height: 1.6;
  box-sizing: border-box;
}

.input-placeholder {
  color: #a4a6aa;
}

.char-count {
  position: absolute;
  right: 14px;
  bottom: 10px;
  color: #a4a6aa;
  font-size: 13px;
}

.action-row {
  display: flex;
  margin-top: 14px;
}

.parse-button {
  flex: 1;
  margin-right: 10px;
}

.paste-button {
  width: 120px;
  flex: 0 0 120px;
}

.legal-copy {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 18px 6px;
  color: #8a8a8a;
  font-size: 13px;
  line-height: 22px;
  text-align: center;
}

.utility-list {
  padding: 0 16px;
  background: #fff;
  border-radius: 12px;
}

.utility-row {
  display: flex;
  align-items: center;
  height: 66px;
  border-bottom: 1px solid #ededee;
}

.utility-row-last {
  border-bottom: 0;
}

.utility-icon {
  width: 27px;
  height: 27px;
  margin-right: 17px;
}

.utility-title {
  flex: 1;
  font-size: 17px;
  font-weight: 500;
}

.chevron {
  width: 20px;
  height: 20px;
}

@media (max-width: 360px) {
  .input-panel {
    height: 190px;
  }

  .paste-button {
    width: 96px;
    flex-basis: 96px;
  }

  .legal-copy {
    font-size: 12px;
  }
}

