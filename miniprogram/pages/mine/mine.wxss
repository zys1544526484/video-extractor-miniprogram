.mine-page {
  padding-top: 18px;
}

.profile-row {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
  padding: 18px;
  background: #fff;
  border-radius: 12px;
}

.app-avatar {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 52px;
  height: 52px;
  margin-right: 14px;
  background: #f0faf4;
  border-radius: 13px;
}

.app-avatar image {
  width: 30px;
  height: 30px;
}

.profile-copy,
.entitlement-card > view {
  display: flex;
  flex-direction: column;
}

.app-name {
  font-size: 19px;
  font-weight: 650;
}

.app-subtitle {
  margin-top: 2px;
  color: #8a8a8a;
  font-size: 13px;
}

.entitlement-card {
  display: flex;
  align-items: center;
  margin-bottom: 16px;
  padding: 17px 18px;
  background: #fff;
  border: 1px solid #e7e8eb;
  border-radius: 12px;
}

.entitlement-card > view {
  min-width: 0;
  flex: 1;
}

.entitlement-title {
  font-size: 17px;
  font-weight: 600;
}

.entitlement-expiry {
  margin-top: 3px;
  color: #8a8a8a;
  font-size: 13px;
}

.entitlement-state {
  margin-left: 10px;
  padding: 4px 9px;
  color: #8a8a8a;
  font-size: 12px;
  background: #f3f4f5;
  border-radius: 5px;
}

.is-entitled {
  background: #f0faf4;
  border-color: #bfeccf;
}

.is-entitled .entitlement-state {
  color: #07c160;
  background: #fff;
}

.mine-list {
  padding: 0 16px;
  background: #fff;
  border-radius: 12px;
}

.mine-row {
  display: flex;
  align-items: center;
  width: 100%;
  height: 58px;
  padding: 0;
  color: #1f1f1f;
  font-size: 16px;
  line-height: 58px;
  text-align: left;
  background: #fff;
  border-bottom: 1px solid #ededee;
  border-radius: 0;
  box-sizing: border-box;
}

.mine-row > text {
  flex: 1;
}

.mine-row image {
  width: 19px;
  height: 19px;
}

.share-row {
  border-bottom: 0;
}

.mine-footer {
  display: flex;
  flex-direction: column;
  margin-top: 20px;
  color: #a0a1a4;
  font-size: 12px;
  line-height: 20px;
  text-align: center;
}

