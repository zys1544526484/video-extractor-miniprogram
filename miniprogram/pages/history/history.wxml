<view class="page-shell history-page">
  <view class="retention-note">
    <text class="retention-title">最近 24 小时</text>
    <text>已完成视频可直接再次打开和保存，过期后自动清理</text>
  </view>

  <view class="history-summary" wx:if="{{activeCount}}">
    <text>{{activeCount}} 个任务正在后台处理</text>
    <text class="refresh-copy">页面会自动刷新</text>
  </view>

  <view class="history-list" wx:if="{{jobs.length}}">
    <view class="history-card" wx:for="{{jobs}}" wx:key="job_id">
      <view class="history-card-heading">
        <text class="platform-badge">{{item.platform_label}}</text>
        <text class="history-status {{item.ready ? 'history-status-ready' : ''}}">{{item.status_label}}</text>
      </view>
      <text class="history-title">{{item.title}}</text>
      <text class="history-meta">{{item.detail || item.stage}}</text>
      <view class="history-progress" wx:if="{{item.active}}">
        <view class="history-progress-value" style="width: {{item.progress}}%;"></view>
      </view>
      <view class="history-footer">
        <text class="history-time">{{item.created_label}}</text>
        <button class="history-action" loading="{{openingJobId === item.job_id}}" data-id="{{item.job_id}}" bindtap="openJob">{{item.action_label}}</button>
      </view>
    </view>
  </view>

  <view class="history-empty" wx:elif="{{!loading}}">
    <text class="history-empty-title">暂无提取记录</text>
    <text>{{errorText || '完成一次提取后，结果会在这里保留 24 小时'}}</text>
  </view>

  <view class="history-loading" wx:else>正在读取提取记录…</view>
</view>
