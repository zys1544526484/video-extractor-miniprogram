.result-page {
  padding-top: 10px;
  padding-bottom: calc(28px + env(safe-area-inset-bottom));
}

.ad-region {
  margin-bottom: 14px;
  overflow: hidden;
  border-radius: 10px;
}

.dev-ad {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 48px;
  color: #8a8a8a;
  font-size: 12px;
  background: #fff;
  border: 1px dashed #d6d7da;
  border-radius: 10px;
}

.success-line {
  display: flex;
  align-items: center;
  margin: 4px 0 16px;
  color: #07c160;
  font-size: 20px;
  font-weight: 600;
}

.success-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 30px;
  height: 30px;
  margin-right: 10px;
  color: #fff;
  font-size: 17px;
  background: #07c160;
  border-radius: 50%;
}

.video-preview {
  width: 100%;
  height: calc((100vw - 32px) * 0.5625);
  overflow: hidden;
  background: #101010;
  border-radius: 12px;
}

.result-tabs {
  display: flex;
  margin-bottom: 14px;
  padding: 4px;
  background: #fff;
  border-radius: 10px;
}

.result-tab {
  flex: 1;
  padding: 9px 0;
  color: #73757a;
  font-size: 15px;
  text-align: center;
  border-radius: 8px;
}

.result-tab-active {
  color: #07a950;
  font-weight: 600;
  background: #eefaf3;
}

.source-entry {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: -4px 0 14px;
  padding: 11px 13px;
  background: #fff;
  border: 1px solid #e7e8eb;
  border-radius: 10px;
}

.source-entry-label,
.source-entry-value {
  display: block;
}

.source-entry-label {
  color: #8a8a8a;
  font-size: 12px;
}

.source-entry-value {
  max-width: 270px;
  margin-top: 3px;
  overflow: hidden;
  color: #333438;
  font-size: 14px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.source-entry-arrow {
  color: #07a950;
  font-size: 14px;
}

.link-actions {
  display: flex;
  margin: -4px 0 14px;
}

.link-button {
  flex: 1;
  margin: 0 6px 0 0;
  padding: 0;
  color: #07a950;
  font-size: 13px;
  line-height: 32px;
  background: #fff;
  border: 1px solid #b9e8ca;
  border-radius: 7px;
}

.link-button:last-child {
  margin-right: 0;
}

.image-list {
  display: flex;
  flex-direction: column;
}

.image-card {
  margin-bottom: 12px;
  overflow: hidden;
  background: #fff;
  border: 1px solid #e7e8eb;
  border-radius: 10px;
}

.result-image {
  display: block;
  width: 100%;
  min-height: 100px;
  background: #f1f2f4;
}

.image-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10px 12px;
  color: #5f6166;
  font-size: 13px;
}

.image-save-button {
  margin: 0;
  padding: 0 13px;
  color: #07a950;
  font-size: 13px;
  line-height: 30px;
  background: #eefaf3;
  border: 1px solid #b9e8ca;
  border-radius: 6px;
}

.tab-empty {
  display: flex;
  align-items: center;
  flex-direction: column;
  justify-content: center;
  min-height: 240px;
  color: #8a8a8a;
  font-size: 14px;
  text-align: center;
}

.tab-empty-title {
  margin-bottom: 8px;
  color: #5f6166;
  font-size: 17px;
}

.title-card {
  padding: 18px 16px;
  background: #fff;
  border: 1px solid #e7e8eb;
  border-radius: 12px;
}

.title-card-label {
  display: block;
  color: #8a8a8a;
  font-size: 13px;
}

.title-card-title {
  display: block;
  margin-top: 6px;
  color: #202124;
  font-size: 19px;
  font-weight: 600;
  line-height: 28px;
}

.share-label {
  margin-top: 20px;
}

.share-text {
  display: block;
  max-height: 190px;
  margin-top: 7px;
  overflow: auto;
  color: #4d4f54;
  font-size: 15px;
  line-height: 24px;
  white-space: pre-wrap;
}

.title-actions {
  display: flex;
  margin-top: 18px;
}

.title-actions button {
  flex: 1;
  margin: 0 8px 0 0;
}

.title-actions button:last-child {
  margin-right: 0;
}

.source-sheet-mask {
  position: fixed;
  z-index: 20;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: rgba(0, 0, 0, 0.42);
}

.source-sheet {
  position: absolute;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 18px 16px calc(18px + env(safe-area-inset-bottom));
  background: #f7f8fa;
  border-radius: 18px 18px 0 0;
}

.sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12px;
  color: #202124;
  font-size: 17px;
  font-weight: 600;
}

.sheet-close {
  color: #07a950;
  font-size: 14px;
  font-weight: 400;
}

.source-option {
  display: flex;
  align-items: center;
  margin-top: 9px;
  padding: 12px;
  background: #fff;
  border: 1px solid #e1e3e5;
  border-radius: 10px;
}

.source-option-selected {
  border-color: #07c160;
  box-shadow: 0 0 0 1px rgba(7, 193, 96, 0.12);
}

.source-option-number {
  width: 45px;
  color: #07a950;
  font-size: 14px;
  font-weight: 600;
}

.source-option-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  color: #34363a;
  font-size: 14px;
  line-height: 22px;
}

.source-option-copy text:last-child {
  color: #8a8a8a;
  font-size: 12px;
}

.source-option-check {
  margin-left: 8px;
  color: #07a950;
  font-size: 12px;
}

.media-heading {
  display: flex;
  align-items: flex-start;
  margin: 16px 0;
}

.platform-label {
  flex: 0 0 auto;
  margin-right: 12px;
  padding: 4px 9px;
  color: #58595d;
  font-size: 13px;
  line-height: 20px;
  background: #fff;
  border: 1px solid #dedfe1;
  border-radius: 5px;
}

.media-copy {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
}

.media-title {
  overflow: hidden;
  color: #1f1f1f;
  font-size: 19px;
  font-weight: 600;
  line-height: 28px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.media-info {
  margin-top: 3px;
  color: #8a8a8a;
  font-size: 14px;
}

.notice-card {
  margin-bottom: 18px;
  padding: 0 15px;
  background: #fff;
  border: 1px solid #e7e8eb;
  border-radius: 10px;
}

.notice-row {
  display: flex;
  align-items: center;
  min-height: 53px;
  color: #73757a;
  font-size: 14px;
  border-bottom: 1px solid #ededee;
}

.notice-row-last {
  border-bottom: 0;
}

.notice-symbol {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 21px;
  height: 21px;
  margin-right: 11px;
  color: #8a8a8a;
  font-size: 12px;
  font-weight: 600;
  border: 1.5px solid #8a8a8a;
  border-radius: 50%;
  box-sizing: border-box;
}

.progress-block {
  margin: 2px 2px 18px;
}

.progress-label {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8px;
  color: #73757a;
  font-size: 14px;
}

.progress-track {
  height: 4px;
  overflow: hidden;
  background: #e4e5e7;
  border-radius: 2px;
}

.progress-value {
  height: 100%;
  background: #07c160;
  border-radius: 2px;
  transition: width 160ms ease;
}

.save-button,
.retry-button {
  width: 100%;
}

.retry-button {
  margin-top: 10px;
}

.expiry-hint,
.mock-hint {
  display: block;
  margin-top: 14px;
  color: #8a8a8a;
  font-size: 13px;
  text-align: center;
}

.mock-hint {
  margin-top: 5px;
  color: #b07b21;
}

.empty-state {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 70vh;
  color: #8a8a8a;
}
