.tab-bar {
  position: fixed;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  height: calc(62px + env(safe-area-inset-bottom));
  padding-bottom: env(safe-area-inset-bottom);
  background: #fff;
  border-top: 1px solid #e7e8eb;
  box-sizing: border-box;
}

.tab-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #8a8a8a;
}

.tab-icon {
  width: 25px;
  height: 25px;
  margin-bottom: 2px;
}

.tab-label {
  font-size: 12px;
  line-height: 18px;
}

.is-active {
  color: #07c160;
}

