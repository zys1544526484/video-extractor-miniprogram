APP_ENV=development
VERSION=0.1.0
DATABASE_URL=sqlite:///./data/app.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_TOKEN_SECRET=replace-this-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MOCK_WECHAT_AUTH=true
DEV_BYPASS_DOWNLOAD_ENTITLEMENT=false
DOWNLOAD_ACCESS_MODE=free
MAX_VIDEO_BYTES=188743680
MAX_SOURCE_VIDEO_BYTES=2147483648
MIN_FREE_DISK_BYTES=10737418240
PARSE_TIMEOUT_SECONDS=1800
MEDIA_PROCESSING_TIMEOUT_SECONDS=1800
MEDIA_SESSION_TTL_SECONDS=86400
TEMP_FILE_TTL_SECONDS=90000
PARSE_JOB_TTL_SECONDS=86400
MAX_REDIRECTS=5
HTTP_TIMEOUT_SECONDS=20
GLOBAL_PARSE_CONCURRENCY=2
PARSE_WORKER_CONCURRENCY=2
MEDIA_PROCESSING_CONCURRENCY=1
MAX_ACTIVE_PARSE_JOBS_PER_USER=2
MAX_QUEUED_PARSE_JOBS=20
USER_PARSE_LIMIT_PER_10_MINUTES=10
AD_ATTEMPT_MIN_SECONDS=5
AD_ATTEMPT_TTL_SECONDS=600
TEMP_DIR=./tmp/media
LOG_LEVEL=INFO
