APP_ENV=development
VERSION=0.1.0
DATABASE_URL=sqlite:///./data/app.db
PUBLIC_BASE_URL=http://127.0.0.1:8000
APP_TOKEN_SECRET=replace-this-with-at-least-32-random-characters
AUTH_TOKEN_TTL_SECONDS=604800
WECHAT_APP_ID=
WECHAT_APP_SECRET=
MOCK_WECHAT_AUTH=true
MAX_VIDEO_BYTES=188743680
PARSE_TIMEOUT_SECONDS=30
MEDIA_SESSION_TTL_SECONDS=900
TEMP_FILE_TTL_SECONDS=1800
MAX_REDIRECTS=5
HTTP_TIMEOUT_SECONDS=20
GLOBAL_PARSE_CONCURRENCY=4
USER_PARSE_LIMIT_PER_10_MINUTES=10
TEMP_DIR=./tmp/media
LOG_LEVEL=INFO

