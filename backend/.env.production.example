APP_ENV=production
VERSION=0.1.0
DATABASE_URL=sqlite:///./data/app.db
PUBLIC_BASE_URL=https://api.example.com
APP_TOKEN_SECRET=replace-with-a-cryptographically-random-secret
AUTH_TOKEN_TTL_SECONDS=604800
WECHAT_APP_ID=wx0000000000000000
WECHAT_APP_SECRET=replace-with-real-wechat-app-secret
MOCK_WECHAT_AUTH=false
DEV_BYPASS_DOWNLOAD_ENTITLEMENT=false
MAX_VIDEO_BYTES=188743680
PARSE_TIMEOUT_SECONDS=30
MEDIA_SESSION_TTL_SECONDS=900
TEMP_FILE_TTL_SECONDS=1800
MAX_REDIRECTS=5
HTTP_TIMEOUT_SECONDS=20
GLOBAL_PARSE_CONCURRENCY=4
USER_PARSE_LIMIT_PER_10_MINUTES=10
AD_ATTEMPT_MIN_SECONDS=5
AD_ATTEMPT_TTL_SECONDS=600
TEMP_DIR=./tmp/media
LOG_LEVEL=INFO
